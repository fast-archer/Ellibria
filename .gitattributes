# Документация (не считается языком программирования)
docs/** linguist-documentation
*.md linguist-documentation
LICENSE linguist-documentation

# Игнорируем логи и временные файлы
__pycache__/ linguist-generated
*.pyc linguist-generated
*.log linguist-generated

# Игнорируем автосгенерированные артефакты
*.spec linguist-generated
*.exe linguist-generated
*.ico linguist-generated

# Игнорируем JSON (кроме случаев, если у вас проект на JSON-языке)
*.json linguist-generated

# ВАЖНО: исключаем только нужные текстовые файлы, 
# если нужно оставить requirements.txt видимым, просто уберите его из списка
*.txt linguist-generated
# Исключаем файлы из статистики (чтобы они не влияли на проценты)
*.html linguist-detectable=false
*.json linguist-detectable=false
*.log linguist-detectable=false
